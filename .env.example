# Contact form endpoint (Formspree or your own API). Empty = opens an email draft.
VITE_FORM_ENDPOINT=
# Cookieless analytics (no consent banner needed): your site domain
VITE_PLAUSIBLE_DOMAIN=
# Google Analytics 4 (loads only after the visitor accepts cookies)
VITE_GA_ID=
# Public URL of the live site, used for the sitemap, canonical links and social previews
VITE_SITE_URL=https://www.your-domain.com
